﻿﻿@model TSWeb.Models.DangNhapDKModels
@{
    ViewBag.Title = "DangNhap";
    <link href="~/Content/Css/LoginStyleSheet.css" rel="stylesheet" />
    Layout = null;
    string errorMessage = TempData["ErrorMessage"] as string;
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&amp;display=swap" rel="stylesheet" />

}

<div class="container">
    <div class="login-section" id="loginSection">
        <div class="image-section">
            <img src="~/Content/Picture/5.jpg" alt="bubble milk tea" />
        </div>
        <div class="form-section">
            <form action="/DangNhapDK/XuLyDangNhap" method="post">
                <h2>Đăng nhập</h2>
                <div class="input-group">
                    <i class="fas fa-user"></i>
                    <input placeholder="Email" type="text" name="email" />
                </div>
                <div class="input-group">
                    <i class="fas fa-lock"></i>
                    <input placeholder="Password" type="password" name="matkhau" />
                </div>
                <div class="btn-container">
                    <button class="btn" type="submit">Đăng nhập</button>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div id="error-message" style="color: red; margin-top: 10px;text-align:center;">
                            @errorMessage
                        </div>
                    }
                </div>
                <div class="create-account">
                    <a href="#" onclick="showRegisterForm()">Tạo một tài khoản</a>
                </div>
            </form>
        </div>
    </div>

    
    <div class="register-section" id="registerSection" style="display: none;">
        <div class="image-container">
            <img src="~/Content/Picture/8.jpg" alt="milk tea" />
        </div>
        <div class="form-section">
            <form action="/DangNhapDK/DangKy" method="post">
                <h2>Đăng ký</h2>
                <div class="form-group">
                    <i class="fas fa-user"></i>
                    <input placeholder="Họ và tên" type="text" name="hoten" />
                </div>
                <div class="form-group">
                    <i class="fas fa-envelope"></i>
                    <input placeholder="Email" type="email" name="email" />
                </div>
                <div class="form-group">
                    <i class="fas fa-lock"></i>
                    <input placeholder="Mật khẩu" type="password" name="matkhau" />
                </div>
                <div class="form-group">
                    <i class="fas fa-lock"></i>
                    <input placeholder="Nhập lại mật khẩu" type="password" name="nhaplaimatkhau" />
                </div>
                <div class="form-group">
                    <i class="fas fa-phone"></i>
                    <input placeholder="Số điện thoại" type="text" name="sdt" />
                </div>
                <div class="form-group">
                    <i class="fas fa-home"></i>
                    <input placeholder="Địa chỉ" type="text" name="diachi" />
                </div>
                <div class="btn-container">
                    <button class="btn" type="submit">Đăng ký</button>
                </div>
                <div class="already-member">
                    <a href="#" onclick="showLoginForm()">Tôi đã đăng ký</a>
                </div>
            </form>
        </div>
    </div>
</div>


<script type="text/javascript">

    function showRegisterForm() {
        document.getElementById('loginSection').style.display = 'none';
        document.getElementById('registerSection').style.display = 'flex';
    }

    function showLoginForm() {
        document.getElementById('registerSection').style.display = 'none';
        document.getElementById('loginSection').style.display = 'flex';
    }

    document.addEventListener("DOMContentLoaded", function () {
        const form = document.querySelector(".signupform form");

        form.addEventListener("submit", function (event) {
            const hoten = form.hoten.value.trim();
            const email = form.email.value.trim();
            const matkhau = form.matkhau.value;
            const nhaplaimatkhau = form.nhaplaimatkhau.value;
            const sdt = form.sdt.value.trim();
            const diachi = form.diachi.value.trim();

            let isValid = true;
            let errorMessage = "";

            if (hoten.length < 3) {
                isValid = false;
                errorMessage += "Họ và tên phải có ít nhất 3 ký tự.\n";
            }
            const uppercaseRegex = /[A-Z]/; // Chữ viết hoa

            if (matkhau.length < 8) {
                isValid = false;
                errorMessage += "Mật khẩu phải có ít nhất 8 ký tự.\n";
            }
            if (!uppercaseRegex.test(matkhau)) {
                isValid = false;
                errorMessage += "Mật khẩu phải chứa ít nhất một chữ cái viết hoa.\n";
            }

            if (matkhau !== nhaplaimatkhau) {
                isValid = false;
                errorMessage += "Mật khẩu và nhập lại mật khẩu không khớp.\n";
            }

            const phoneRegex = /^[0-9]{10,11}$/;
            if (!phoneRegex.test(sdt)) {
                isValid = false;
                errorMessage += "Số điện thoại phải gồm 10-11 chữ số.\n";
            }

            if (diachi.length < 5) {
                isValid = false;
                errorMessage += "Địa chỉ phải có ít nhất 5 ký tự.\n";
            }

            if (!isValid) {
                event.preventDefault(); // Ngăn gửi form
                alert(errorMessage);   // Hiển thị lỗi
            }
        });
    });
</script>


<script src="~/Scripts/LoginJavaScript.js"></script>