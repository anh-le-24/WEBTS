@{
    ViewBag.Title = "Chỉnh Sửa Topping";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<style>
    .container {
        max-width: 500px;
        margin: auto;
        padding: 20px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        font-weight: bold;
        display: block;
        margin-bottom: 5px;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 16px;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 20px;
    }

    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.3s ease-in-out;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }

    .btn-secondary {
        background-color: #007bff;
        color: white;
    }

        .btn-secondary:hover {
            background-color: #0056b3;
        }
</style>
<div class="container">
    <h2 class="form-title" style="text-align:center; padding-bottom: 25px">CHỈNH SỬA TOPPING</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary(false)
        </div>
    }

    <form action="~/Admin/CapNhatTopping" method="post" class="topping-form" id="toppingForm">
        @{
            var topping = ViewBag.Topping != null && ViewBag.Topping.Count > 0 ? ViewBag.Topping[0] : null;
        }

        <input type="hidden" name="IDTP" value="@(topping != null ? topping[0] : "")" />

        <div class="form-group">
            <label for="TenTP">Tên Topping *</label>
            <input type="text" id="TenTP" name="TenTP" class="form-control" required
                   value="@(topping != null ? topping[1] : "")" />
        </div>

        <div class="form-group">
            <label for="GiaTP">Giá Topping *</label>
            <input type="number" step="1000" id="GiaTP" name="GiaTP" class="form-control" required
                   min="1000" value="@(topping != null ? topping[2] : "0")" />
        </div>

        <div class="form-group">
            <label for="NgayTao">Ngày Tạo *</label>
            <input type="date" id="NgayTao" name="NgayTao" class="form-control" required
                   value="@(topping != null ? topping[3]?.ToString("yyyy-MM-dd") : "")" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Cập Nhật</button>
            <a href="@Url.Action("Topping", "Admin")" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>

<script>document.addEventListener("DOMContentLoaded", function () {
        const ngayTaoInput = document.getElementById('NgayTao');
        if (!ngayTaoInput.value) {
            ngayTaoInput.value = new Date().toISOString().split('T')[0];
        }
    });</script>