@{
    ViewBag.Title = "Quản lý thanh toán";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<style>
    .container {
        width: 90%;
        margin: 20px auto;
    }

    /* Thanh tìm kiếm & nút thêm */
    .search-add-container {
        display: flex;
        gap: 10px;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .search-filter {
        display: flex;
        gap: 10px;
        align-items: center;
    }

        .search-filter input, .search-filter select, .btn_search {
            height: 40px;
            padding: 8px 15px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

    .btn_search {
        background-color: #007bff;
        color: white;
        border: none;
        cursor: pointer;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 150px;
        height: 40px;
    }

        .btn_search:hover {
            background-color: #0056b3;
            transform: scale(1.05);
        }

    .btn_add {
        background-color: green;
        color: white;
        border: none;
        cursor: pointer;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 150px;
        text-decoration: none;
        height: 40px;
    }

        .btn_add:hover {
            background-color: orange;
            transform: scale(1.05);
        }

        .btn_add .btn_icon:hover {
            display: none;
        }

        .btn_add:hover .btn_text {
            display: none;
        }

        .btn_add:hover .btn_icon {
            display: inline;
        }

        .btn_add:hover .btn_text {
            display: none; /* Ẩn chữ khi hover */
        }

        .btn_add:hover .btn_icon {
            display: inline;
        }

    .btn_icon {
        display: none;
        font-size: 18px;
        font-weight: bold;
    }

    /* Bảng danh sách */
    .table-container {
        background: white;
        padding: 15px;
        border-radius: 8px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 8px;
        overflow: hidden;
    }

    th, td {
        border: 1px solid #ddd;
        padding: 10px;
        text-align: center;
    }

    th {
        background-color: #f8f9fa;
        font-weight: bold;
    }

    .action-buttons {
        display: flex;
        gap: 5px;
        justify-content: center;
    }

    .btn-view {
        background-color: #28a745;
    }

    .btn-edit {
        background-color: #007bff;
    }

    .btn-delete {
        background-color: #dc3545;
    }

    .btn-view, .btn-edit, .btn-delete {
        padding: 8px 10px;
        text-decoration: none;
        border-radius: 5px;
        color: white;
        font-weight: bold;
        width: 60px;
        text-align: center;
        display: inline-block;
    }

        .btn-view:hover {
            background-color: #218838;
        }

        .btn-edit:hover {
            background-color: #0056b3;
        }

        .btn-delete:hover {
            background-color: #c82333;
        }
</style>

<div class="container">
    <h1 style="text-align:center; padding-bottom: 25px">QUẢN LÝ THANH TOÁN</h1>

    <!-- Thanh tìm kiếm, bộ lọc và nút thêm -->
    <div class="search-add-container">
        @using (Html.BeginForm("QLThanhToan", "Admin", FormMethod.Get))
        {
            <div class="search-filter">
                <input type="text" name="idDonHang" placeholder="Nhập Mã Thanh Toán" value="@Request.QueryString["idDonHang"]" />
                <select name="hinhThucThanhToan">
                    <option value="">-- Chọn Hình Thức --</option>
                    <option value="Tiền mặt">Tiền mặt</option>
                    <option value="Ngân hàng">Ngân hàng</option>
                    <option value="Ví điện tử">Ví điện tử</option>
                    <option value="Thanh toán khi nhận hàng">Thanh toán khi nhận hàng</option>
                </select>
                <button type="submit" class="btn_search">Lọc</button>
            </div>
        }
        <a href="@Url.Action("ThemThanhToan", "Admin")" class="btn_add">
        <span class="btn_text">Thanh Toán Mới</span>
        <span class="btn_icon">+</span>
        </a>
    </div>

    <!-- Bảng danh sách thanh toán -->
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>IDTT</th>
                    <th>Ngày Thanh Toán</th>
                    <th>Tổng Tiền</th>
                    <th>Hình Thức Thanh Toán</th>
                    <th>ID Đơn Hàng</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in ViewBag.list)
                {
                    if (string.IsNullOrEmpty(Request.QueryString["hinhThucThanhToan"]) || a[3].ToString().Contains(Request.QueryString["hinhThucThanhToan"]))
                    {
                        <tr>
                            <td>@a[0]</td>
                            <td>@a[1]</td>
                            <td>@a[2]</td>
                            <td>@a[3]</td>
                            <td>@a[4]</td>
                            <td>
                                <div class="action-buttons">
                                    <a href="@Url.Action("XemChiTietThanhToan", "Admin", new { id = a[0] })" class="btn-view">Xem</a>
                                    <a href="@Url.Action("ChinhSuaThanhToan", "Admin", new { id = a[0] })" class="btn-edit">Sửa</a>
                                    <a href="javascript:void(0);" onclick="confirmDelete(@a[0])" class="btn-delete">Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function confirmDelete(id) {
        if (confirm("Bạn có chắc muốn xóa thanh toán này không?")) {
            window.location.href = '@Url.Action("XoaThanhToan", "Admin")?id=' + id;
        }
    }
</script>
