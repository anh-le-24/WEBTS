@{
    ViewBag.Title = "Chỉnh sửa khách hàng";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<style>
    .container {
        max-width: 500px;
        margin: 30px auto;
        padding: 20px;
        background: white;
        border-radius: 8px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
        color: #333;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        font-weight: bold;
        display: block;
        margin-bottom: 5px;
    }

    input {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 16px;
    }

    .btn-container {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
    }

    .btn {
        padding: 10px 15px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        text-align: center;
    }

    .btn-save {
        background-color: #007bff;
        color: white;
        flex: 1;
        margin-right: 10px;
    }

        .btn-save:hover {
            background-color: #0056b3;
        }

    .btn-cancel {
        background-color: #6c757d;
        color: white;
        flex: 1;
        text-decoration:none;
    }

        .btn-cancel:hover {
            background-color: #5a6268;
        }
</style>

<div class="container">
    <h2>Chỉnh sửa thông tin khách hàng</h2>

    <form action="@Url.Action("ChinhSuaKH", "Admin")" method="post">
        <!-- Ẩn input IDND để lưu giá trị khách hàng -->
        <input type="hidden" name="IDND" value="@ViewBag.list[0][0]" />

        <div class="form-group">
            <label for="FullName">Họ Tên</label>
            <input type="text" id="FullName" name="FullName" required placeholder="Nguyễn Văn A" value="@ViewBag.list[0][1]" />
        </div>

        <div class="form-group">
            <label for="Email">Email</label>
            <input type="email" id="Email" name="Email" required placeholder="example@gmail.com" value="@ViewBag.list[0][2]" />
        </div>

        <div class="form-group">
            <label for="Password">Mật Khẩu</label>
            <input type="password" id="Password" name="Password" class="form-control" placeholder="Để trống nếu không muốn thay đổi" />
        </div>

        <div class="form-group">
            <label for="PhoneNumber">Số Điện Thoại</label>
            <input type="tel" id="PhoneNumber" name="PhoneNumber" value="@ViewBag.list[0][4]" />
        </div>

        <div class="form-group">
            <label for="Address">Địa Chỉ</label>
            <input type="text" id="Address" name="Address" value="@ViewBag.list[0][5]" />
        </div>

        <div class="form-group">
            <label for="TB">Nhận thông báo</label>
            <select id="TB" name="TB" class="form-control">
                <option value="Có" @((ViewBag.list[0][10]?.ToString() == "Có") ? "selected" : "")>Có</option>
                <option value="Không" @((ViewBag.list[0][10]?.ToString() == "Không") ? "selected" : "")>Không</option>
            </select>

        </div>

        <div class="btn-container">
            <button type="submit" class="btn btn-save"><i class="fas fa-save"></i> Cập nhật</button>
            <a href="javascript:history.back()" class="btn btn-cancel"><i class="fas fa-times"></i> Hủy</a>
        </div>
    </form>
</div>
